# ---------- Which IdP / mail adapters to use ----------
IDP_PROVIDER=strivacity
MAIL_PROVIDER=mailosaur

# ---------- Application under test (the app that redirects to the hosted login journey) ----------
APP_BASE_URL=https://your-app.example.com
LOGIN_START_PATH=/
# regex (as a string) that the URL must match after a successful login
POST_LOGIN_URL_PATTERN=your-app\.example\.com
# two-step = identifier screen, then password screen. single-step = both on one screen
LOGIN_STYLE=two-step

# ---------- Strivacity Admin API (client credentials) ----------
STRIVACITY_TENANT=your-brand.strivacity.com
STRIVACITY_IDENTITY_STORE=your-identity-store-name
STRIVACITY_CLIENT_ID=
STRIVACITY_CLIENT_SECRET=
# Lock type sent to POST .../accounts/{id}/lock (confirm allowed values in your tenant's OpenAPI spec)
STRIVACITY_LOCK_TYPE=password
# Failed password attempts before the tenant locks the account (see your brute-force protection settings)
LOCKOUT_THRESHOLD=5

# ---------- Mail capture (Mailosaur) ----------
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=
# Optional regex (string) used to pick the right link in the reset email
RESET_LINK_PATTERN=reset|recover|password

# ---------- Outlook / Microsoft Graph (MAIL_PROVIDER=outlook) ----------
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=qa.mailbox@yourcompany.com
# Unique per-test addresses are built as qa.mailbox+<unique>@yourcompany.com (plus-addressing must be enabled)
OUTLOOK_ALIAS_BASE=qa.mailbox@yourcompany.com
# First capture group = the user id. Adjust to the wording of your email.
USER_ID_PATTERN=User\s*ID\s*[:\-]?\s*([A-Za-z0-9._@+-]+)

# ---------- STV Demo app (registration journey) ----------
# true = start journeys by clicking the "Login" / "Registration" links in the demo app's top navigation
DEMO_APP_NAV=true
REGISTRATION_START_PATH=/
